{
	"name": "@alexandria/worker",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --ip 0.0.0.0 --local",
		"dev:staging": "dotenv -e ../../.env -- wrangler dev --ip 0.0.0.0 --env staging --remote",
		"dev:remote": "dotenv -e ../../.env -- wrangler dev --ip 0.0.0.0 --remote",
		"deploy:prod": "dotenv -e ../../.env -- wrangler deploy --config wrangler.toml",
		"deploy:staging": "dotenv -e ../../.env -- wrangler deploy --config wrangler.toml --env staging"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.56",
		"@ai-sdk/google": "^4.0.74",
		"@ai-sdk/openai": "^4.0.69",
		"@ai-sdk/provider-utils": "^5.0.43",
		"@alexandria/core": "*",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"ai": "^7.0.105",
		"hono": "^4.10.6",
		"jose": "^6.1.3",
		"stripe": "^22.6.2",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20251121.0",
		"dotenv-cli": "^7.4.4",
		"wrangler": "^4.32.0"
	}
}
