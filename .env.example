# Copy to .env. Nothing here is read by the deployed worker — these are for the
# CLI in cli/, which drives wrangler. The worker's own configuration lives in
# wrangler secrets (see docs/DEPLOYMENT.md) and, locally, in .dev.vars.

# Leave CLOUDFLARE_API_TOKEN unset to use your `wrangler login` session, which
# is the simpler path. If you do set it, wrangler prefers it over that session —
# so a stale token here makes every --remote command fail with
# "Authentication error [code: 10000]" while `wrangler whoami` still looks fine.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# The user whose rows the extract:* scripts pull. `npm run db:admin-id -- --env production`.
USER_ID=

# Cloudflare Access application the worker validates JWTs against.
TEAM_DOMAIN=https://your-team.cloudflareaccess.com
POLICY_AUD=your-application-aud-tag
ADMIN_EMAIL=you@example.com
