{
	"name": "alexandria",
	"description": "One backend for works and writing. Hono on Cloudflare Workers, D1 and R2.",
	"workspaces": [
		"apps/*",
		"packages/*",
		"cli"
	],
	"scripts": {
		"dev": "npm run dev -w @alexandria/worker",
		"test": "vitest run",
		"test:watch": "vitest",
		"dev:setup": "npm run dev:setup -w @alexandria/cli --",
		"deploy:prod": "npm run deploy:prod -w @alexandria/worker",
		"deploy:staging": "npm run deploy:staging -w @alexandria/worker",
		"db:admin-id": "npm run db:admin-id -w @alexandria/cli --",
		"db:status": "npm run db:status -w @alexandria/cli --",
		"db:status:local": "npm run db:status:local -w @alexandria/cli",
		"db:status:staging": "npm run db:status:staging -w @alexandria/cli",
		"db:status:prod": "npm run db:status:prod -w @alexandria/cli",
		"spend": "npm run spend -w @alexandria/cli --",
		"spend:staging": "npm run spend:staging -w @alexandria/cli",
		"spend:prod": "npm run spend:prod -w @alexandria/cli",
		"db:compare": "npm run db:compare -w @alexandria/cli --",
		"db:compare:local-staging": "npm run db:compare:local-staging -w @alexandria/cli",
		"db:compare:staging-prod": "npm run db:compare:staging-prod -w @alexandria/cli",
		"sql:local": "npm run sql:local -w @alexandria/cli --",
		"stripe:setup": "npm run stripe:setup -w @alexandria/cli --",
		"sql:staging": "npm run sql:staging -w @alexandria/cli --",
		"sql:production": "npm run sql:production -w @alexandria/cli --",
		"migrate:events": "npm run migrate:events -w @alexandria/cli --",
		"extract:all": "npm run extract:all -w @alexandria/cli",
		"extract:notes": "npm run extract:notes -w @alexandria/cli --",
		"extract:thoughts": "npm run extract:thoughts -w @alexandria/cli --",
		"extract:books": "npm run extract:books -w @alexandria/cli --",
		"extract:quotes": "npm run extract:quotes -w @alexandria/cli --",
		"extract:sleep": "npm run extract:sleep -w @alexandria/cli --",
		"extract:threads": "npm run extract:threads -w @alexandria/cli --",
		"extract:essays": "npm run extract:essays -w @alexandria/cli --",
		"pages:extract": "npm run pages:extract -w @alexandria/cli --",
		"pages:index": "npm run pages:index -w @alexandria/cli --",
		"backup": "npm run backup:prod -w @alexandria/cli",
		"backup:staging": "npm run backup:staging -w @alexandria/cli",
		"backup:prod": "npm run backup:prod -w @alexandria/cli",
		"verify:tokens": "npm run verify:tokens -w @alexandria/cli --",
		"verify:tokens:local": "npm run verify:tokens:local -w @alexandria/cli",
		"verify:tokens:staging": "npm run verify:tokens:staging -w @alexandria/cli",
		"verify:tokens:prod": "npm run verify:tokens:prod -w @alexandria/cli",
		"assert:deployable": "npm run assert:deployable -w @alexandria/cli --",
		"assert:deployable:staging": "npm run assert:deployable:staging -w @alexandria/cli",
		"assert:deployable:prod": "npm run assert:deployable:prod -w @alexandria/cli",
		"assert:migrated": "npm run assert:migrated -w @alexandria/cli --",
		"assert:migrated:staging": "npm run assert:migrated:staging -w @alexandria/cli",
		"assert:migrated:prod": "npm run assert:migrated:prod -w @alexandria/cli",
		"debug:auth": "npm run debug:auth -w @alexandria/cli --",
		"debug:auth:local": "npm run debug:auth:local -w @alexandria/cli",
		"debug:auth:staging": "npm run debug:auth:staging -w @alexandria/cli",
		"debug:auth:prod": "npm run debug:auth:prod -w @alexandria/cli",
		"lint": "eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20251121.0",
		"@eslint/js": "^9.39.1",
		"@google/gemini-cli": "^0.27.3",
		"@types/node": "^24.3.0",
		"concurrently": "^9.2.1",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.6.2",
		"tsx": "^4.20.4",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.47.0",
		"vitest": "^5.0.1",
		"wrangler": "^4.90.0"
	},
	"dependencies": {
		"fast-xml-parser": "5.3.5"
	}
}
